# What the stack does not embed. Symfony makes its cache in the paths of the
# WASM filesystem, when the stack is built
/var/
# Twice in public/bundles/easyadmin/: EasyAdmin only reads its manifest there
/vendor/easycorp/easyadmin-bundle/public/**
!/vendor/easycorp/easyadmin-bundle/public/*.json
# The fixtures only speak English
/vendor/fakerphp/faker/src/Faker/Provider/*_*/
!/vendor/fakerphp/faker/src/Faker/Provider/en_US/
# The application speaks English and French: keep in sync with enabled_locales
# in config/packages/framework.yaml
/vendor/symfony/intl/Resources/data/*/*
!/vendor/symfony/intl/Resources/data/*/en.php
!/vendor/symfony/intl/Resources/data/*/fr.php
!/vendor/symfony/intl/Resources/data/*/meta.php
!/vendor/symfony/intl/Resources/data/*/root.php
# What the application never runs
/vendor/**/Tests/
/vendor/**/tests/
/vendor/**/doc/
/vendor/**/docs/
