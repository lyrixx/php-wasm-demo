# The application runs in a browser, in ../../public/easyadmin/: nothing here
# is a secret.
APP_ENV=prod
APP_SECRET=it-runs-in-a-browser-it-is-not-a-secret

# /easyadmin is kept in IndexedDB, keep in sync with persist in
# ../../public/easyadmin/index.html
DATABASE_URL="sqlite:////easyadmin/shop.sqlite"
SESSIONS_DIR=/easyadmin/sessions
