# The application runs in a browser, in ../../public/pop-quiz/: nothing here
# is a secret.
APP_NAME="Pop Quiz"
APP_ENV=production
APP_KEY=base64:SF9RyEM4B9SsVrB7IVhyRgGfQzn8PlbJu849SeWp1Xg=
APP_DEBUG=false
APP_URL=http://localhost

# What Laravel logs goes to the console of the browser
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# /pop-quiz is kept in IndexedDB, keep in sync with persist in
# ../../public/pop-quiz/index.html
DB_CONNECTION=sqlite
DB_DATABASE=/pop-quiz/database.sqlite

SESSION_DRIVER=database
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BROADCAST_CONNECTION=log
